{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gh.thio.cc.cd" }],
      "destination": "https://github.com/flessan"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "github.thio.cc.cd" }],
      "destination": "https://github.com/flessan"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "git.thio.cc.cd" }],
      "destination": "https://github.com/flessan"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gdips.thio.cc.cd" }],
      "destination": "https://gdips.pages.dev"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ig.thio.cc.cd" }],
      "destination": "https://www.instagram.com/flethio"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "threads.thio.cc.cd" }],
      "destination": "https://www.threads.com/flethio"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "yt.thio.cc.cd" }],
      "destination": "https://youtube.com/@flethio"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sponsor.thio.cc.cd" }],
      "destination": "https://github.com/sponsors/flessan"
    }
  ]
}
